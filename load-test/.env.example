# ── SAO Recruitment Load Test configuration ──
# คัดลอกเป็น .env แล้วกรอกค่าจริง (.env ถูก git-ignore)

# ปลายทาง (default = Cloudflare environment ปัจจุบัน)
LOAD_TEST_FRONTEND_URL=https://sao-recruitment-frontend.pages.dev
LOAD_TEST_API_URL=https://sao-recruitment-backend.hrmsao.workers.dev/api/v1

# โหมด local (ทางเลือก — หรือใช้ flag --local แทนได้)
# LOAD_TEST_LOCAL_FRONTEND_URL=http://localhost:3000
# LOAD_TEST_LOCAL_API_URL=http://localhost:8787/api/v1

# ⭐ บัญชี admin (ใช้กับ setup-round / seed / admin-check / cleanup)
LOAD_TEST_ADMIN_EMAIL=
LOAD_TEST_ADMIN_PASSWORD=

# ปรับพฤติกรรมการจำลอง (default ตามข้อกำหนดแล้ว)
# LOAD_TEST_USERS=250
# LOAD_TEST_BATCH=5
# LOAD_TEST_THINK_MIN=5
# LOAD_TEST_THINK_MAX=30
# LOAD_TEST_BATCH_GAP_MIN=2
# LOAD_TEST_BATCH_GAP_MAX=8
# LOAD_TEST_TURNSTILE_TIMEOUT=120

# ระบุ round id ตรง ๆ (ปกติ setup-round.mjs เขียน results/state.json ให้แล้ว)
# LOAD_TEST_ROUND_ID=
