# Cloudflare Workers Environment Variables
# Copy this file to .dev.vars and fill in your actual values

# JWT Secret for token signing (use a strong random string in production)
JWT_SECRET=change_me_to_a_random_secret_string_at_least_32_chars

# R2 Storage Credentials
# Get these from Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=sao-storage
