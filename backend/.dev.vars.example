# Cloudflare Workers Environment Variables
# Copy this file to .dev.vars and fill in your actual values

# JWT Secret for token signing (use a strong random string in production)
JWT_SECRET=change_me_to_a_random_secret_string_at_least_32_chars

# =============================================================================
# PR #1 - Hardening / Anti-bot foundation
# =============================================================================
# These are the *local development* values. They mirror the safe defaults
# declared in wrangler.toml. The middleware layer falls back to those
# defaults if a variable is missing, so you can leave any of them empty
# while testing.
#
#  HONEYPOT_FIELD_NAME       Hidden form field checked by honeypot middleware.
#  RATE_LIMIT_ENABLED        Per-IP rate limiter master switch.
#  RATE_LIMIT_PER_MINUTE     Max requests per minute per IP.
#  IDEMPOTENCY_ENABLED       Idempotency-token master switch.
#  IDEMPOTENCY_TTL_SECONDS   Token TTL in seconds (15 min default).
#  TURNSTILE_ENABLED         Cloudflare Turnstile widget switch.
#  TURNSTILE_SITE_KEY        Public site key served via /public/config.
#  TURNSTILE_SECRET_KEY      Server-side secret (not used in PR #1).
# =============================================================================
HONEYPOT_FIELD_NAME=website_url
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=5
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=900
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
