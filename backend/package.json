{
  "name": "sao-recruitment-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npx wrangler types && npx tsc --noEmit",
    "typecheck": "npx tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sao-db --local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-presigned-post": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@hono/zod-validator": "^0.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "hono": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
